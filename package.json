{
  "name": "pilgrim-mechanica-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mech salvage game in the browser: a moving convoy village, swarms, procedural walkers on streamed dunes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node tools/run-checks.mjs",
    "shots": "node tools/shots.mjs",
    "icons": "node tools/icons.mjs",
    "test:serial": "node tools/run-checks.mjs -j 1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "~0.12.0",
    "three": "~0.186.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "~0.186.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^7.1.0"
  }
}
