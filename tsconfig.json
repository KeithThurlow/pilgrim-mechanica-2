{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src", "labs", "tools/*.ts"],
  "exclude": ["tools/fbx-to-glb.ts", "tools/weapons-import.ts", "tools/armoury-check.ts", "tools/report-plugin.ts", "tools/bandit-vat-check.ts", "tools/blastwaves-check.ts"]
}
